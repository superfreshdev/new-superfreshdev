{

  "paths": {

    "pathImgDocCard": "media/imgs/content/02-codings/docs/",
    "pathIconWhite": "media/imgs/icons/02-icon-colors/02-white/",
    "pathIconBlack": "media/imgs/icons/02-icon-colors/01-black/"

  },

  "docCategoryContainer": {

    "cssClass": "docs-category-container",

    "header": {

      "cssClass": "docs-category-header",
